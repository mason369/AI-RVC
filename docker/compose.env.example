# 复制到仓库根目录 .env。默认值即可在本机使用。
AI_RVC_BIND=127.0.0.1
AI_RVC_PORT=7860
# 只有已发布/导入对应镜像时才设置 AI_RVC_IMAGE，否则按 compose 文件本地构建。
# AI_RVC_IMAGE=ghcr.io/mason369/ai-rvc:1.5.0-cuda
# 反向代理子路径，例如 /ai-rvc；没有子路径时保持为空。
AI_RVC_ROOT_PATH=
# 登录：与 compose.auth.yaml 一起使用。密码写在 docker/secrets/password.txt。
# AI_RVC_AUTH_USER=rvc
# AI_RVC_AUTH_PASSWORD_FILE=/run/secrets/ai_rvc_password
