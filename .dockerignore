# Literal/prefix-only exceptions let BuildKit prune virtual environments.
# Wildcard exceptions disable this optimization (tonistiigi/fsutil filter.go).
**
!Dockerfile
!pre-requirements.txt
!requirements.txt
!requirements_cpu.txt
!requirements_cuda.txt
!requirements_dml.txt
!requirements_hf.txt
!run.py
!app.py
!LICENSE
!README.md
!VERSION
!configs
!i18n
!infer
!lib
!models
!rvc_mcp
!tools
!ui
!docker
# Only runtime source directories above are allowed; artifacts/secrets stay out.
**/node_modules
**/__pycache__
**/.git
**/.env
**/.env.*
**/AGENTS.md
**/CLAUDE.md
**/*.log
**/*.tmp
**/*.bak
**/*.ps1
**/*.exe
**/*.dll
**/*.pth
**/*.pt
**/*.ckpt
**/*.onnx
**/*.index
**/*.wav
**/*.mp3
**/*.flac
**/*.zip
**/*.7z
tools/ffmpeg
ui/multitrack/dist
docker/secrets
docker/data
